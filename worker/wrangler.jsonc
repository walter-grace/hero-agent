{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hero-jobs-worker",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The always-on scheduler: every 5 minutes, so durable-TWAP chunks can pace at 5-minute
  // granularity. run-due and the TWAP executor are both interval-gated + idempotent, so a tighter
  // cadence only bounds how soon due work runs — it never double-fires.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Agents this cron runs. Must be owned by AGENT_PRIVATE_KEY's wallet (memory is owner-key-encrypted).
    // Set to your test agent; comma-separate to run several, e.g. "3,4,6".
    "AGENT_IDS": "4",
    "HERO_MEM_ADDR": "0x881a9f7ed58b7655c3c04bb2f9ef2cffd233a5ef",
    "RH_RPC": "https://rpc.mainnet.chain.robinhood.com",
    "HERO_BASE": "https://herorunai.com"
  }
  // Secrets (wrangler secret put): AGENT_PRIVATE_KEY, HERO_RUN_KEY, RUN_SECRET
}
