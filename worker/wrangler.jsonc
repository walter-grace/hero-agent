{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hero-jobs-worker",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The always-on scheduler: every 5 minutes, so durable-TWAP chunks can pace at 5-minute
  // granularity. run-due and the TWAP executor are both interval-gated + idempotent, so a tighter
  // cadence only bounds how soon due work runs — it never double-fires.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Agents this cron runs. Must be owned by AGENT_PRIVATE_KEY's wallet (memory is owner-key-encrypted).
    // Set to your test agent; comma-separate to run several, e.g. "3,4,6".
    "AGENT_IDS": "10",
    // Also service every agent the operator wallet owns on-chain, discovered per tick. This is what
    // makes swarms autonomous: swarm_spawn mints agents at runtime, and nobody redeploys the worker
    // per swarm. Opt-in on purpose — with it on, minting an agent IS enrolling it in the cron.
    "AGENT_DISCOVER": "1",
    "HERO_MEM_ADDR": "0xce4dc968827a996f7bd5bbdb0fcb72348b18d0dc",
    "HERO_BASE": "https://herorunai.com",
    // Shared "run it for me" mode: the worker pulls every registered plan from here and runs each
    // with its own scoped session key. Pairs with the WORKER_SECRET secret. Leave AGENT_IDS empty
    // to run ONLY shared plans, or set it to also service your own agents.
    "REGISTRY_URL": "https://herorunai.com",
    // Tier 3 backstop keeper: the on-chain HeroTwapKeeper (permissionless DCA into RH stocks with
    // USDG). Each tick, pollKeeper executes any due chunk so plans run even if no third-party bot
    // shows up. Uses AGENT_PRIVATE_KEY's wallet to submit + earns the USDG keeper reward. Inert
    // when empty. Production keeper (minHold = 1,000,000 HERO gate) on Robinhood Chain (4663).
    "KEEPER_ADDRESS": "0x5404e5753942c6d7660f0036b6dac35aafd09093"
    // RH_RPC is now a SECRET (Alchemy RH endpoint w/ API key) — set via `wrangler secret put RH_RPC`.
    // The public RPC rate-limited the worker mid-tick; a private endpoint has the headroom.
  }
  // Secrets (wrangler secret put): AGENT_PRIVATE_KEY, HERO_RUN_KEY, RUN_SECRET
}
